							"name": "CountCrashes"
						}
					],
					"scriptLines": [
						"source(output(",
						"          ACCIDENT_NO as string,",
						"          SPEED_ZONE as string,",
						"          YEAR as string,",
						"          NO_PERSONS_KILLED as string,",
						"          NO_PERSONS_INJ_2 as string,",
						"          SEVERITY_DESC as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> cleanedAccidentData",
						"cleanedAccidentData filter(toFloat(NO_PERSONS_KILLED) > 0 || toFloat(NO_PERSONS_INJ_2) > 0 || in(['Fatal accident', 'Serious injury accident'], SEVERITY_DESC)) ~> FilterSevereCrashes",
						"FilterSevereCrashes aggregate(groupBy(SPEED_ZONE,",
						"          ACCIDENT_YEAR = YEAR),",
						"     FATAL_CRASH_COUNT = sum(toFloat(NO_PERSONS_KILLED)),",
						"          INJURY_CRASH_COUNT = sum(toFloat(NO_PERSONS_INJ_2))) ~> CountCrashes",
						"CountCrashes sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          SPEED_ZONE as string,",
						"          ACCIDENT_YEAR as integer,",
						"          FATAL_CRASH_COUNT as integer,",
						"          INJURY_CRASH_COUNT as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     truncate:true,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          SPEED_ZONE,",
						"          ACCIDENT_YEAR,",
						"          CRASH_COUNT = FATAL_CRASH_COUNT",
						"     )) ~> SevereCrashesSink"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/cleanedAccidentData')]",
				"[concat(variables('factoryId'), '/datasets/SeverCrashCount')]"
			]
		},
