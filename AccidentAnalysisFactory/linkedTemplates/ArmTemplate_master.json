{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "AccidentAnalysisFactory"
		},
		"cleaneData_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'cleaneData'"
		},
		"roadDataAnalysisDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'roadDataAnalysisDB'"
		},
		"roadDataAnalysisDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "victoriadataanalysis.database.windows.net"
		},
		"roadDataAnalysisDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "roadDataAnalysis"
		},
		"roadDataAnalysisDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "user"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "AccidentAnalysisFactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"cleaneData_connectionString": {
						"value": "[parameters('cleaneData_connectionString')]"
					},
					"roadDataAnalysisDB_password": {
						"value": "[parameters('roadDataAnalysisDB_password')]"
					},
					"roadDataAnalysisDB_properties_typeProperties_server": {
						"value": "[parameters('roadDataAnalysisDB_properties_typeProperties_server')]"
					},
					"roadDataAnalysisDB_properties_typeProperties_database": {
						"value": "[parameters('roadDataAnalysisDB_properties_typeProperties_database')]"
					},
					"roadDataAnalysisDB_properties_typeProperties_userName": {
						"value": "[parameters('roadDataAnalysisDB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}