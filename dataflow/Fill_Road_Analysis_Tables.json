{
	"name": "Fill_Road_Analysis_Tables",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "cleanedAccidentData",
						"type": "DatasetReference"
					},
					"name": "cleanedAccidnetData"
				},
				{
					"dataset": {
						"referenceName": "cleanedVehicleData",
						"type": "DatasetReference"
					},
					"name": "cleanedVehicleData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AccidentDetails",
						"type": "DatasetReference"
					},
					"name": "AccidentDetails"
				},
				{
					"dataset": {
						"referenceName": "AccidentOutcome",
						"type": "DatasetReference"
					},
					"name": "AccidentOutcome"
				},
				{
					"dataset": {
						"referenceName": "VehicleDetails",
						"type": "DatasetReference"
					},
					"name": "VehicleDetails"
				}
			],
			"transformations": [
				{
					"name": "SelectAccidentDetails"
				},
				{
					"name": "SelectAccidentOutcome"
				},
				{
					"name": "columnsToBeAggregated"
				},
				{
					"name": "SortForLevelOfDamage"
				},
				{
					"name": "aggregateColumns"
				},
				{
					"name": "JoinAccidentOutcome"
				},
				{
					"name": "deriveDataTypes"
				},
				{
					"name": "FormatAccidentOutcome"
				},
				{
					"name": "SelectVehicleDetails"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          ACCIDENT_TYPE_DESC as string,",
				"          DCA_DESC as string,",
				"          NO_OF_VEHICLES as string,",
				"          NO_PERSONS_KILLED as string,",
				"          NO_PERSONS_INJ_2 as string,",
				"          NO_PERSONS_INJ_3 as string,",
				"          NO_PERSONS_NOT_INJ as string,",
				"          NO_PERSONS as string,",
				"          ROAD_GEOMETRY_DESC as string,",
				"          SPEED_ZONE as string,",
				"          RMA as string,",
				"          SEVERITY_DESC as string,",
				"          LIGHT_CONDITION_DESC as string,",
				"          POLICE_ATTEND_DESC as string,",
				"          ACCIDENT_DATETIME as string,",
				"          TIME_OF_DAY_BUCKET as string,",
				"          YEAR as string,",
				"          MONTH as string,",
				"          SEASON as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cleanedAccidnetData",
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          VEHICLE_ID as string,",
				"          VEHICLE_YEAR_MANUF as string,",
				"          VEHICLE_DCA_CODE as string,",
				"          INITIAL_DIRECTION as string,",
				"          ROAD_SURFACE_TYPE as string,",
				"          ROAD_SURFACE_TYPE_DESC as string,",
				"          REG_STATE as string,",
				"          VEHICLE_BODY_STYLE as string,",
				"          VEHICLE_MAKE as string,",
				"          VEHICLE_MODEL as string,",
				"          VEHICLE_TYPE as string,",
				"          VEHICLE_TYPE_DESC as string,",
				"          VEHICLE_WEIGHT as string,",
				"          CONSTRUCTION_TYPE as string,",
				"          FUEL_TYPE as string,",
				"          NO_OF_WHEELS as string,",
				"          NO_OF_CYLINDERS as string,",
				"          SEATING_CAPACITY as string,",
				"          TARE_WEIGHT as string,",
				"          TOTAL_NO_OCCUPANTS as string,",
				"          CARRY_CAPACITY as string,",
				"          CUBIC_CAPACITY as string,",
				"          FINAL_DIRECTION as string,",
				"          DRIVER_INTENT as string,",
				"          VEHICLE_MOVEMENT as string,",
				"          TRAILER_TYPE as string,",
				"          VEHICLE_COLOUR_1 as string,",
				"          VEHICLE_COLOUR_2 as string,",
				"          CAUGHT_FIRE as string,",
				"          INITIAL_IMPACT as string,",
				"          LAMPS as string,",
				"          LEVEL_OF_DAMAGE as string,",
				"          TOWED_AWAY_FLAG as string,",
				"          TRAFFIC_CONTROL as string,",
				"          TRAFFIC_CONTROL_DESC as string,",
				"          YEAR_QUALITY_STATUS as string,",
				"          {YEAR_QUALITY STATUS} as string,",
				"          CAUGHT_FIRE_DESC as string,",
				"          LEVEL_OF_DAMAGE_DESC as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cleanedVehicleData",
				"cleanedAccidnetData select(mapColumn(",
				"          ACCIDENT_NO,",
				"          ACCIDENT_TYPE_DESC,",
				"          DCA_DESC,",
				"          NO_OF_VEHICLES,",
				"          ROAD_GEOMETRY_DESC,",
				"          SPEED_ZONE,",
				"          RMA,",
				"          LIGHT_CONDITION_DESC,",
				"          POLICE_ATTEND_DESC,",
				"          ACCIDENT_DATETIME,",
				"          TIME_OF_DAY_BUCKET,",
				"          YEAR,",
				"          MONTH,",
				"          SEASON",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAccidentDetails",
				"cleanedAccidnetData select(mapColumn(",
				"          ACCIDENT_NO,",
				"          NO_PERSONS_KILLED,",
				"          NO_PERSONS_INJ_2,",
				"          NO_PERSONS_INJ_3,",
				"          NO_PERSONS_NOT_INJ,",
				"          NO_PERSONS,",
				"          SEVERITY_DESC",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAccidentOutcome",
				"cleanedVehicleData select(mapColumn(",
				"          ACCIDENT_NO,",
				"          CAUGHT_FIRE,",
				"          LEVEL_OF_DAMAGE,",
				"          TOWED_AWAY_FLAG,",
				"          LEVEL_OF_DAMAGE_DESC",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> columnsToBeAggregated",
				"columnsToBeAggregated sort(asc(ACCIDENT_NO, true),",
				"     desc(toFloat(LEVEL_OF_DAMAGE), true)) ~> SortForLevelOfDamage",
				"SortForLevelOfDamage aggregate(groupBy(ACCIDENT_NO),",
				"     NO_VEHICLES_CAUGHT_FIRE = countIf(CAUGHT_FIRE == '1' || upper(CAUGHT_FIRE) == 'Y' || upper(CAUGHT_FIRE) == 'YES'),",
				"          NO_VEHICLES_TOWED = countIf(TOWED_AWAY_FLAG == '1' || upper(TOWED_AWAY_FLAG) == 'Y' || upper(TOWED_AWAY_FLAG) == 'YES'),",
				"          MAX_DAMAGE_LEVEL_DESC = first(LEVEL_OF_DAMAGE_DESC)) ~> aggregateColumns",
				"SelectAccidentOutcome, aggregateColumns join(SelectAccidentOutcome@ACCIDENT_NO == aggregateColumns@ACCIDENT_NO,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinAccidentOutcome",
				"JoinAccidentOutcome derive(NO_PERSONS = toInteger(NO_PERSONS),",
				"          NO_PERSONS_KILLED = toInteger(NO_PERSONS_KILLED),",
				"          NO_PERSONS_INJ_2 = toInteger(NO_PERSONS_INJ_2),",
				"          NO_PERSONS_INJ_3 = toInteger(NO_PERSONS_INJ_3),",
				"          NO_PERSONS_NOT_INJ = toInteger(NO_PERSONS_NOT_INJ),",
				"          NO_VEHICLES_TOWED = iifNull(NO_VEHICLES_TOWED, 0),",
				"          NO_VEHICLES_CAUGHT_FIRE = iifNull(NO_VEHICLES_CAUGHT_FIRE, 0)) ~> deriveDataTypes",
				"deriveDataTypes select(mapColumn(",
				"          ACCIDENT_NO = SelectAccidentOutcome@ACCIDENT_NO,",
				"          NO_PERSONS,",
				"          NO_PERSONS_KILLED,",
				"          NO_PERSONS_INJ_2,",
				"          NO_PERSONS_INJ_3,",
				"          NO_PERSONS_NOT_INJ,",
				"          SEVERITY_DESC,",
				"          NO_VEHICLES_TOWED,",
				"          NO_VEHICLES_CAUGHT_FIRE,",
				"          MAX_DAMAGE_LEVEL_DESC",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> FormatAccidentOutcome",
				"cleanedVehicleData select(mapColumn(",
				"          ACCIDENT_NO,",
				"          VEHICLE_ID,",
				"          VEHICLE_YEAR_MANUF,",
				"          VEHICLE_DCA_CODE,",
				"          REG_STATE,",
				"          VEHICLE_BODY_STYLE,",
				"          VEHICLE_MAKE,",
				"          VEHICLE_MODEL,",
				"          VEHICLE_TYPE,",
				"          VEHICLE_TYPE_DESC,",
				"          VEHICLE_WEIGHT,",
				"          CONSTRUCTION_TYPE,",
				"          FUEL_TYPE,",
				"          NO_OF_WHEELS,",
				"          NO_OF_CYLINDERS,",
				"          SEATING_CAPACITY,",
				"          TARE_WEIGHT,",
				"          CARRY_CAPACITY,",
				"          CUBIC_CAPACITY,",
				"          TRAILER_TYPE,",
				"          VEHICLE_COLOUR_1,",
				"          VEHICLE_COLOUR_2,",
				"          LAMPS,",
				"          TRAFFIC_CONTROL,",
				"          TRAFFIC_CONTROL_DESC,",
				"          YEAR_QUALITY_STATUS,",
				"          {YEAR_QUALITY STATUS}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehicleDetails",
				"SelectAccidentDetails sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ACCIDENT_NO as string,",
				"          ACCIDENT_DATETIME as timestamp,",
				"          ACCIDENT_TYPE_DESC as string,",
				"          DCA_DESC as string,",
				"          NO_OF_VEHICLES as integer,",
				"          ROAD_GEOMETRY_DESC as string,",
				"          SPEED_ZONE as string,",
				"          RMA as string,",
				"          LIGHT_CONDITION_DESC as string,",
				"          POLICE_ATTEND_DESC as string,",
				"          TIME_OF_DAY_BUCKET as string,",
				"          YEAR as integer,",
				"          MONTH as integer,",
				"          SEASON as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> AccidentDetails",
				"FormatAccidentOutcome sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ACCIDENT_NO as string,",
				"          NO_PERSONS as integer,",
				"          NO_PERSONS_KILLED as integer,",
				"          NO_PERSONS_INJ_2 as integer,",
				"          NO_PERSONS_INJ_3 as integer,",
				"          NO_PERSONS_NOT_INJ as integer,",
				"          SEVERITY_DESC as string,",
				"          NO_VEHICLES_TOWED as integer,",
				"          NO_VEHICLES_CAUGHT_FIRE as integer,",
				"          MAX_DAMAGE_LEVEL_DESC as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> AccidentOutcome",
				"SelectVehicleDetails sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ACCIDENT_NO as string,",
				"          VEHICLE_ID as string,",
				"          VEHICLE_YEAR_MANUF as integer,",
				"          VEHICLE_MAKE as string,",
				"          VEHICLE_MODEL as string,",
				"          VEHICLE_BODY_STYLE as string,",
				"          VEHICLE_TYPE as integer,",
				"          VEHICLE_TYPE_DESC as string,",
				"          REG_STATE as string,",
				"          FUEL_TYPE as string,",
				"          CONSTRUCTION_TYPE as string,",
				"          NO_OF_WHEELS as integer,",
				"          NO_OF_CYLINDERS as integer,",
				"          SEATING_CAPACITY as integer,",
				"          TARE_WEIGHT as integer,",
				"          VEHICLE_WEIGHT as integer,",
				"          CARRY_CAPACITY as integer,",
				"          CUBIC_CAPACITY as integer,",
				"          TRAILER_TYPE as string,",
				"          VEHICLE_COLOUR_1 as string,",
				"          VEHICLE_COLOUR_2 as string,",
				"          YEAR_QUALITY_STATUS as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> VehicleDetails"
			]
		}
	}
}