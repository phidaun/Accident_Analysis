{
	"name": "Fill_Vehicle_Details",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "cleanedVehicleData",
						"type": "DatasetReference"
					},
					"name": "cleanedVehicleData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "VehicleDetails",
						"type": "DatasetReference"
					},
					"name": "VehicleDetails"
				}
			],
			"transformations": [
				{
					"name": "SelectVehicleDetails"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          VEHICLE_ID as string,",
				"          VEHICLE_YEAR_MANUF as string,",
				"          VEHICLE_DCA_CODE as string,",
				"          INITIAL_DIRECTION as string,",
				"          ROAD_SURFACE_TYPE as string,",
				"          ROAD_SURFACE_TYPE_DESC as string,",
				"          REG_STATE as string,",
				"          VEHICLE_BODY_STYLE as string,",
				"          VEHICLE_MAKE as string,",
				"          VEHICLE_MODEL as string,",
				"          VEHICLE_TYPE as string,",
				"          VEHICLE_TYPE_DESC as string,",
				"          VEHICLE_WEIGHT as string,",
				"          CONSTRUCTION_TYPE as string,",
				"          FUEL_TYPE as string,",
				"          NO_OF_WHEELS as string,",
				"          NO_OF_CYLINDERS as string,",
				"          SEATING_CAPACITY as string,",
				"          TARE_WEIGHT as string,",
				"          TOTAL_NO_OCCUPANTS as string,",
				"          CARRY_CAPACITY as string,",
				"          CUBIC_CAPACITY as string,",
				"          FINAL_DIRECTION as string,",
				"          DRIVER_INTENT as string,",
				"          VEHICLE_MOVEMENT as string,",
				"          TRAILER_TYPE as string,",
				"          VEHICLE_COLOUR_1 as string,",
				"          VEHICLE_COLOUR_2 as string,",
				"          CAUGHT_FIRE as string,",
				"          INITIAL_IMPACT as string,",
				"          LAMPS as string,",
				"          LEVEL_OF_DAMAGE as string,",
				"          TOWED_AWAY_FLAG as string,",
				"          TRAFFIC_CONTROL as string,",
				"          TRAFFIC_CONTROL_DESC as string,",
				"          YEAR_QUALITY_STATUS as string,",
				"          {YEAR_QUALITY STATUS} as string,",
				"          CAUGHT_FIRE_DESC as string,",
				"          LEVEL_OF_DAMAGE_DESC as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cleanedVehicleData",
				"cleanedVehicleData select(mapColumn(",
				"          ACCIDENT_NO,",
				"          VEHICLE_ID,",
				"          VEHICLE_YEAR_MANUF,",
				"          VEHICLE_DCA_CODE,",
				"          REG_STATE,",
				"          VEHICLE_BODY_STYLE,",
				"          VEHICLE_MAKE,",
				"          VEHICLE_MODEL,",
				"          VEHICLE_TYPE,",
				"          VEHICLE_TYPE_DESC,",
				"          VEHICLE_WEIGHT,",
				"          CONSTRUCTION_TYPE,",
				"          FUEL_TYPE,",
				"          NO_OF_WHEELS,",
				"          NO_OF_CYLINDERS,",
				"          SEATING_CAPACITY,",
				"          TARE_WEIGHT,",
				"          CARRY_CAPACITY,",
				"          CUBIC_CAPACITY,",
				"          TRAILER_TYPE,",
				"          VEHICLE_COLOUR_1,",
				"          VEHICLE_COLOUR_2,",
				"          LAMPS,",
				"          TRAFFIC_CONTROL,",
				"          TRAFFIC_CONTROL_DESC,",
				"          YEAR_QUALITY_STATUS,",
				"          {YEAR_QUALITY STATUS}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehicleDetails",
				"SelectVehicleDetails sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          ACCIDENT_NO as string,",
				"          VEHICLE_ID as string,",
				"          VEHICLE_YEAR_MANUF as integer,",
				"          VEHICLE_MAKE as string,",
				"          VEHICLE_MODEL as string,",
				"          VEHICLE_BODY_STYLE as string,",
				"          VEHICLE_TYPE as integer,",
				"          VEHICLE_TYPE_DESC as string,",
				"          REG_STATE as string,",
				"          FUEL_TYPE as string,",
				"          CONSTRUCTION_TYPE as string,",
				"          NO_OF_WHEELS as integer,",
				"          NO_OF_CYLINDERS as integer,",
				"          SEATING_CAPACITY as integer,",
				"          TARE_WEIGHT as integer,",
				"          VEHICLE_WEIGHT as integer,",
				"          CARRY_CAPACITY as integer,",
				"          CUBIC_CAPACITY as integer,",
				"          TRAILER_TYPE as string,",
				"          VEHICLE_COLOUR_1 as string,",
				"          VEHICLE_COLOUR_2 as string,",
				"          YEAR_QUALITY_STATUS as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> VehicleDetails"
			]
		}
	}
}