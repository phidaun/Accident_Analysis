{
	"name": "Fill_Severe_Crashes_By_Speed_Zone",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "cleanedAccidentData",
						"type": "DatasetReference"
					},
					"name": "cleanedAccidentData"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SeverCrashCount",
						"type": "DatasetReference"
					},
					"name": "SevereCrashesSink"
				}
			],
			"transformations": [
				{
					"name": "CountCrashes"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          SPEED_ZONE as string,",
				"          YEAR as string,",
				"          NO_PERSONS_KILLED as string,",
				"          NO_PERSONS_INJ_2 as string,",
				"          SEVERITY_DESC as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> cleanedAccidentData",
				"cleanedAccidentData aggregate(groupBy(SPEED_ZONE,",
				"          ACCIDENT_YEAR = YEAR),",
				"     CRASH_COUNT = countIf(toInteger(NO_PERSONS_KILLED) > 0 || toInteger(NO_PERSONS_INJ_2) > 0)) ~> CountCrashes",
				"CountCrashes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SPEED_ZONE as string,",
				"          ACCIDENT_YEAR as integer,",
				"          FATAL_CRASH_COUNT as integer,",
				"          INJURY_CRASH_COUNT as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          SPEED_ZONE,",
				"          ACCIDENT_YEAR,",
				"          CRASH_COUNT",
				"     )) ~> SevereCrashesSink"
			]
		}
	}
}