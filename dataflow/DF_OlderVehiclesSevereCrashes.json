{
	"name": "DF_OlderVehiclesSevereCrashes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "SK_AccidentCleaned",
						"type": "DatasetReference"
					},
					"name": "AccidentSource"
				},
				{
					"dataset": {
						"referenceName": "SK_VehicleCleaned",
						"type": "DatasetReference"
					},
					"name": "VehicleSource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "SK_OlderVehicleSevereCrashes",
						"type": "DatasetReference"
					},
					"name": "OlderVehicleSevereSink"
				}
			],
			"transformations": [
				{
					"name": "SelectAccidentFields"
				},
				{
					"name": "SelectVehicleFields"
				},
				{
					"name": "JoinAccidentVehicle"
				},
				{
					"name": "FilterValidManufactureYear"
				},
				{
					"name": "DeriveVehicleAge"
				},
				{
					"name": "FilterOlderSevereVehicles"
				},
				{
					"name": "AggregateOlderVehicles"
				},
				{
					"name": "FormatTable6Output"
				},
				{
					"name": "SelectTable6Columns"
				}
			],
			"scriptLines": [
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          ACCIDENT_TYPE_DESC as string,",
				"          DCA_DESC as string,",
				"          NO_OF_VEHICLES as string,",
				"          NO_PERSONS_KILLED as string,",
				"          NO_PERSONS_INJ_2 as string,",
				"          NO_PERSONS_INJ_3 as string,",
				"          NO_PERSONS_NOT_INJ as string,",
				"          NO_PERSONS as string,",
				"          ROAD_GEOMETRY_DESC as string,",
				"          SPEED_ZONE as string,",
				"          RMA as string,",
				"          SEVERITY_DESC as string,",
				"          LIGHT_CONDITION_DESC as string,",
				"          POLICE_ATTEND_DESC as string,",
				"          ACCIDENT_DATETIME as string,",
				"          TIME_OF_DAY_BUCKET as string,",
				"          YEAR as string,",
				"          MONTH as string,",
				"          SEASON as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> AccidentSource",
				"source(output(",
				"          ACCIDENT_NO as string,",
				"          VEHICLE_ID as string,",
				"          VEHICLE_YEAR_MANUF as string,",
				"          VEHICLE_DCA_CODE as string,",
				"          INITIAL_DIRECTION as string,",
				"          ROAD_SURFACE_TYPE as string,",
				"          ROAD_SURFACE_TYPE_DESC as string,",
				"          REG_STATE as string,",
				"          VEHICLE_BODY_STYLE as string,",
				"          VEHICLE_MAKE as string,",
				"          VEHICLE_MODEL as string,",
				"          VEHICLE_TYPE as string,",
				"          VEHICLE_TYPE_DESC as string,",
				"          CONSTRUCTION_TYPE as string,",
				"          FUEL_TYPE as string,",
				"          NO_OF_WHEELS as string,",
				"          NO_OF_CYLINDERS as string,",
				"          SEATING_CAPACITY as string,",
				"          TARE_WEIGHT as string,",
				"          TOTAL_NO_OCCUPANTS as string,",
				"          FINAL_DIRECTION as string,",
				"          DRIVER_INTENT as string,",
				"          VEHICLE_MOVEMENT as string,",
				"          TRAILER_TYPE as string,",
				"          VEHICLE_COLOUR_1 as string,",
				"          VEHICLE_COLOUR_2 as string,",
				"          CAUGHT_FIRE as string,",
				"          INITIAL_IMPACT as string,",
				"          LAMPS as string,",
				"          LEVEL_OF_DAMAGE as string,",
				"          TOWED_AWAY_FLAG as string,",
				"          TRAFFIC_CONTROL as string,",
				"          TRAFFIC_CONTROL_DESC as string,",
				"          YEAR_QUALITY_STATUS as string,",
				"          CAUGHT_FIRE_DESC as string,",
				"          LEVEL_OF_DAMAGE_DESC as string",
				"     ),",
				"     allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     ignoreNoFilesFound: false) ~> VehicleSource",
				"AccidentSource select(mapColumn(",
				"          ACCIDENT_NO,",
				"          ACCIDENT_YEAR = YEAR,",
				"          NO_PERSONS_KILLED,",
				"          NO_PERSONS_INJ_2",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectAccidentFields",
				"VehicleSource select(mapColumn(",
				"          VEHICLE_ACCIDENT_NO = ACCIDENT_NO,",
				"          VEHICLE_ID,",
				"          VEHICLE_YEAR_MANUF,",
				"          VEHICLE_TYPE_DESC,",
				"          YEAR_QUALITY_STATUS",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehicleFields",
				"SelectAccidentFields, SelectVehicleFields join(ACCIDENT_NO == VEHICLE_ACCIDENT_NO,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> JoinAccidentVehicle",
				"JoinAccidentVehicle filter(YEAR_QUALITY_STATUS == 'Valid'\r",
				"&& !isNull(VEHICLE_YEAR_MANUF)\r",
				"&& !isNull(ACCIDENT_YEAR)\r",
				"&& toInteger(VEHICLE_YEAR_MANUF) > 0\r",
				"&& toInteger(VEHICLE_YEAR_MANUF) <= toInteger(ACCIDENT_YEAR)) ~> FilterValidManufactureYear",
				"FilterValidManufactureYear derive(ACCIDENT_YEAR_INT = toInteger(ACCIDENT_YEAR),",
				"          VEHICLE_YEAR_INT = toInteger(VEHICLE_YEAR_MANUF),",
				"          KILLED_COUNT_INT = toInteger(NO_PERSONS_KILLED),",
				"          SERIOUS_INJURY_COUNT_INT = toInteger(NO_PERSONS_INJ_2),",
				"          VEHICLE_AGE = toInteger(ACCIDENT_YEAR) - toInteger(VEHICLE_YEAR_MANUF)) ~> DeriveVehicleAge",
				"DeriveVehicleAge filter(VEHICLE_AGE >= 15\r",
				"&& (\r",
				"    KILLED_COUNT_INT > 0\r",
				"    || SERIOUS_INJURY_COUNT_INT > 0\r",
				")) ~> FilterOlderSevereVehicles",
				"FilterOlderSevereVehicles aggregate(groupBy(ACCIDENT_YEAR_INT,",
				"          VEHICLE_TYPE_DESC),",
				"     OLDER_VEHICLE_COUNT = count()) ~> AggregateOlderVehicles",
				"AggregateOlderVehicles derive(ACCIDENT_YEAR = toInteger(ACCIDENT_YEAR_INT),",
				"          OLDER_VEHICLE_COUNT = toInteger(OLDER_VEHICLE_COUNT)) ~> FormatTable6Output",
				"FormatTable6Output select(mapColumn(",
				"          ACCIDENT_YEAR,",
				"          VEHICLE_TYPE_DESC,",
				"          OLDER_VEHICLE_COUNT",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectTable6Columns",
				"SelectTable6Columns sink(allowSchemaDrift: false,",
				"     validateSchema: true,",
				"     input(",
				"          ACCIDENT_YEAR as integer,",
				"          VEHICLE_TYPE_DESC as string,",
				"          OLDER_VEHICLE_COUNT as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> OlderVehicleSevereSink"
			]
		}
	}
}